# Server port
PORT=3000

# MongoDB connection string
DATABASE_URL=mongodb://localhost/oraita_db

# Secret key used for JWT token generation and verification
TOKEN_SECRET=your_secret_key_here

# JWT token expiration time
TOKEN_EXPIRATION=1h

# Refresh token expiration time
REFRESH_TOKEN_EXPIRATION=7d

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# Environment
NODE_ENV=development

# Cloudinary credentials (get from cloudinary.com dashboard)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google OAuth Client ID (get from console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id_here
